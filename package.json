{
  "name": "lorewarden",
  "private": true,
  "description": "A local-first toolkit for game masters of 5e-compatible tabletop RPGs.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lorewarden/dm dev",
    "dev:player": "pnpm --filter @lorewarden/player dev",
    "table": "pnpm --filter @lorewarden/player --filter @lorewarden/server build && node packages/server/dist/lorewarden-table.js",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
